# Copy to .env.local and fill in. Never commit real values.

# Optional. Enables live Gemini photo analysis and care-team summary drafts.
# Without it the app works fully with manual entry.
GEMINI_API_KEY=

# Optional. Any multimodal Gemini model your key can use. Run `npm run check:gemini` to list them.
GEMINI_MODEL=gemini-flash-latest

# Where the SQLite database lives. Use a persistent disk path when hosting.
DATA_DIR=./data

# Seed synthetic demo patients on first start when the database is empty (true/false).
SEED_DEMO_DATA=true

# Timezone used to group entries into days.
APP_TIMEZONE=America/Toronto
